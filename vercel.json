{
  "version": 2,
  "buildCommand": "nx build rayms-website --configuration=production",
  "outputDirectory": "dist/apps/rayms-website/browser",
  "routes": [
    {
      "src": "/.*\\.(js|css|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
